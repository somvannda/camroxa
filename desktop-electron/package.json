{
  "name": "camxora-desktop",
  "private": true,
  "version": "2.0.0",
  "description": "Camxora Desktop 2.0.0 — Electron client",
  "author": "Camxora",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n renderer,main,preload,electron -c cyan,magenta,blue,yellow \"vite\" \"npm:watch:main\" \"npm:watch:preload\" \"npm:dev:electron\"",
    "dev:electron": "wait-on http://localhost:5180 && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 CAMXORA_DEV_AUTH=1 electron dist-electron/main.cjs",
    "watch:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:electron-updater --sourcemap --watch",
    "watch:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron --sourcemap --watch",
    "build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --outfile=dist-electron/main.cjs --external:electron --external:electron-updater --sourcemap",
    "build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --outfile=dist-electron/preload.cjs --external:electron --sourcemap",
    "build:renderer": "vite build",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main && npm run build:preload",
    "typecheck": "tsc --noEmit",
    "api:types": "openapi-typescript openapi.json -o src/lib/api-schema.d.ts",
    "api:check": "node scripts/check-openapi.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/smoke.mjs && node tests/e2e/login.mjs && node tests/e2e/media.mjs && node tests/e2e/account.mjs",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.90.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12",
    "electron-updater": "^6.6.2",
    "esbuild": "^0.25.10",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1",
    "vite": "^7.1.9",
    "vitest": "^5.1.1",
    "wait-on": "^8.0.5"
  }
}
