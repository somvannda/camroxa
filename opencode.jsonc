{
  "$schema": "https://opencode.ai/config.json",

  // Limit how many model steps each agent may take inside one turn.
  // On the final step OpenCode removes tools and forces a text summary, so a
  // run can't loop forever and burn tokens. New user input RESETS the
  // allowance, so this caps a single turn, not the whole session.
  // Raised from 40/8/6 after a real task hit "Maximum steps reached" mid-work
  // with the documentation still uncommitted.
  "agents": {
    "build": {
      "steps": 360
    },
    "general": {
      "steps": 360
    },
    "explore": {
      "steps": 360
    }
  },

  // Automatically reduce old conversation context so long sessions
  // don't accumulate a huge (expensive) context window.
  // keep.tokens is how much recent detail survives a compaction, so a feature
  // in flight keeps its exact details.
  // NOTE: 1,000,000 must not exceed the model's usable input window. If the
  // active model caps lower (128k-256k is common), compaction cannot retain a
  // tail that big and long sessions will compact repeatedly. Lower this to
  // match the model if that happens.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 1000000
    },
    "buffer": 20000
  },

  // Don't watch noisy/generated folders. Keeps the file watcher quiet and
  // avoids re-reading large build output.
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/.next/**",
      "**/dist/**",
      "**/build/**",
      "**/target/**",
      "**/__pycache__/**",
      "**/.mypy_cache/**",
      "**/.pytest_cache/**",
      "**/.ruff_cache/**",
      ".git/**",
      "logs/**",
      "uploads/**",
      "marketplace_storage/**",
      "image_output_cache/**"
    ]
  }
}
