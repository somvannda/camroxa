# Same-origin platform API target used by the Next.js rewrite.
PLATFORM_API_URL=http://localhost:8000

# Cloudflare Turnstile site key. In development the app falls back to the
# existing sandbox key; production must provide an explicit key.
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=

# Google Identity Services client ID (public).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Local-only escape hatch. Never set this in sandbox or production.
NEXT_PUBLIC_TURNSTILE_DISABLED=0
