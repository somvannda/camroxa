# Origin of the core API that this app proxies /backend/* to.
# Read at build time by next.config.ts `rewrites()` — set it (e.g. in
# .env.local for dev, or the deploy environment for production) before
# `next build`, or the rewrite falls back to http://localhost:4003.
BACKEND_URL=http://localhost:4003

# Optional Google Search Console ownership token (the `content` value of the
# <meta name="google-site-verification"> tag). When set, app/layout.tsx renders
# the meta tag so the domain can be verified for Google OAuth brand review.
# In production this is injected from the MUSICAPI_GOOGLE_SITE_VERIFICATION
# deploy secret (see scripts/deploy/camxora-musicapi-remote.sh).
GOOGLE_SITE_VERIFICATION=
