# ============================================================
# musicapi environment
# ============================================================
# Copy to `.env` and fill in. Canonical local-dev values (ports 4003/4001/4002,
# DATABASE_URL → local `sunoapi`) are the defaults shown below; only the secret
# fields are blank. A new worktree pointed at the SAME database must reuse the
# canonical `COOKIE_ENCRYPTION_KEY` and `JWT_SECRET` from the existing `.env` —
# generating fresh ones makes the existing encrypted cookies unreadable.

# Durable auth (recommended): paste the Clerk `__client` cookie value (httpOnly,
# from DevTools > Application > Cookies > auth.suno.com). This lets the server
# mint/refresh JWTs automatically.
SUNO_CLIENT_COOKIE=

# Optional: full cookie header (helps Clerk requests). Not strictly required.
SUNO_COOKIE=

# One-off auth (simpler but expires ~1h): paste the `authorization: Bearer ...` JWT.
SUNO_JWT=

# Your browser's device id (ajs_anonymous_id / suno_device_id). Required.
SUNO_DEVICE_ID=

# Advanced (defaults shown).
SUNO_CLERK_URL=https://auth.suno.com
SUNO_API_URL=https://studio-api-prod.suno.com
SUNO_MODEL=chirp-auk-turbo

# Required only for the "generate" (music) command (hCaptcha token).
SUNO_CAPTCHA_TOKEN=

# 2Captcha API key — used to solve hCaptcha automatically (only when required).
TWOCAPTCHA_KEY=

# ============================================================
# Runtime / ports
# ============================================================
# Core API listen port (default 4003).
PORT=4003

# Backend origin that web-user/web-admin proxy /backend/* to.
# Set per-app in web-user/.env.local / web-admin/.env.local for non-default hosts.
BACKEND_URL=http://localhost:4003

# PostgreSQL connection
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sunoapi

# Job queue transport. `memory` (default) runs jobs in-process exactly as before;
# `redis` moves descriptor-backed jobs onto BullMQ workers so a second process can
# adopt work stranded by a crash. Redis must be >= 5.0 (BullMQ's minimum).
# QUEUE_DRIVER=memory
# REDIS_URL=redis://127.0.0.1:6379
# Worker concurrency when QUEUE_DRIVER=redis.
# QUEUE_CONCURRENCY=4

# JWT secret for user sessions — REQUIRED, must be >= 32 chars.
# The server refuses to start if this is missing or left as a placeholder.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Session cookie: the API sets an httpOnly `sunosession` cookie on login. It is
# marked Secure automatically when NODE_ENV=production; set SESSION_COOKIE_SECURE
# to force it on/off (e.g. "false" if serving the frontends over plain HTTP).
# SESSION_COOKIE_SECURE=false

# Reverse-proxy trust. Controls whether req.ip is read from X-Forwarded-For, so it
# drives API-key IP whitelists (`ip_whitelist`). Defaults to off: a directly
# reachable server must NOT trust the header, or clients could spoof their IP.
#   unset / false / 0  -> trust nothing (default)
#   true               -> trust all hops (only for a private/trusted network)
#   <number>           -> trust that many hops from nginx
#   <addr/cidr, ...>   -> trust only these proxy addresses
# The musicapi nginx vhost proxies from loopback, so set this when deployed:
# TRUST_PROXY=127.0.0.1

# Origins allowed to drive cookie-authenticated state-changing requests
# (CSRF defense on top of the cookie's SameSite=Lax). Comma-separated.
# Defaults to the two local dev frontends.
# FRONTEND_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com

# Extra origins allowed to send credentialed (cookie) requests, on top of
# FRONTEND_ORIGINS. Comma-separated, empty by default — the panels call the API
# same-origin through the nginx /backend proxy, so only set this if a client
# calls the API cross-origin directly. The public /v1 API accepts any origin.
# API_CORS_ORIGINS=https://partner.example.com

# Edge rate limiting, keyed per client IP (req.ip — needs TRUST_PROXY behind
# nginx, see above). Global budget per window, plus a stricter budget for the
# credential endpoints /auth/login and /auth/register.
# RATE_LIMIT_MAX=300
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_AUTH_MAX=10

# Per-user limits (req/min, req/day) from the `rate_limits` table, enforced on
# API-key requests and shared across all of a user's keys. Rows are managed in
# the admin panel (PUT /admin/users/:id/rate-limits). Disable the check entirely
# with RATE_LIMIT_PER_USER_ENABLED=false; PER_USER_CACHE_MS bounds how long a
# user's row is cached before it is re-read.
# RATE_LIMIT_PER_USER_ENABLED=true
# RATE_LIMIT_PER_USER_CACHE_MS=30000

# Pino log level for the JSON request/error logs (trace|debug|info|warn|error|fatal|silent).
# LOG_LEVEL=info

# Optional: restrict which hosts a user-supplied webhook `callback_url` may
# point at (comma-separated). Leave empty to allow any public host. Loopback,
# private, link-local, and cloud-metadata addresses are always rejected; when
# this is set, the callback host must equal an entry or be a subdomain of one.
# CALLBACK_ALLOWED_HOSTS=hooks.yourdomain.com,webhooks.partner.com

# AES-256-GCM key used to encrypt Suno account cookies (`suno_accounts.client_cookie`)
# at rest — REQUIRED, must be a 64-character hex string (32 bytes). The server
# refuses to start if this is missing or the wrong size. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# For local dev against the shared `sunoapi` database, DO NOT generate a new key:
# copy the one already in the canonical worktree's `.env` (otherwise every
# encrypted cookie fails with "Unsupported state or unable to authenticate data").
# Keep this stable: rotating it makes existing encrypted cookies unreadable until
# each row is re-entered — see the rotation runbook, production-readiness-plan.md §1.8.
COOKIE_ENCRYPTION_KEY=

# ============================================================
# Google OAuth 2.0 (Sign in with Google)
# ============================================================
# Follow the setup guide below, or see docs.google.com for the full flow.
# You'll need to create a project in Google Cloud Console and create an
# "OAuth 2.0 Client ID" under "APIs & Services > Credentials".
#
# Authorized redirect URIs to register in the Google Cloud Console:
#   Development:
#     - http://localhost:4001/auth/callback   (User workspace — web-user on port 4001)
#   Production (replace with your real domain):
#     - https://<user-host>/auth/callback
#
# NOTE: Google sign-in is enabled for the USER app only. The admin console uses
# email/password exclusively, so do NOT register an admin callback here.

# OAuth Client ID — looks like "xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_ID=

# OAuth Client Secret — found right under the Client ID in the console
GOOGLE_CLIENT_SECRET=

# (Optional) Override the default user-facing redirect URI.
# Defaults to http://localhost:4001/auth/callback in development.
# GOOGLE_REDIRECT_URI_USER=https://app.yourdomain.com/auth/callback

# ============================================================
# ChmabaPay Payment (KHQR / ABA PayWay) — user billing page
# ============================================================
# https://pay.chmaba.com — a KHQR/ABA PayWay aggregator. It never holds funds:
# every payment settles straight into your own ABA PayWay link.
#
# WARNING: there is NO sandbox. Every `ck_live_…` key moves real money. Set up a
# test store pointed at your own PayWay link, mint a 0.01 payment, and pay it
# yourself before pointing the store at the merchant link.
#
# Create the key in the ChmabaPay dashboard (Dashboard > API keys).
CHMABA_API_KEY=

# The store id (st_…) the payments are created against. The store must have an
# ABA PayWay link attached (status "active"). Credit-pack prices must be in the
# store link's currency.
CHMABA_STORE_ID=

# Signing secret (whsec_…) returned when you create the webhook endpoint in the
# ChmabaPay dashboard. Point the webhook URL at:
#   https://musicapi.camxora.com/payments/chmaba/webhook
# Leave blank to reject all deliveries (checkout still works, credits then rely
# on the status poll).
CHMABA_WEBHOOK_SECRET=

# Optional: override the ChmabaPay API base URL (default: production).
CHMABA_API_BASE_URL=https://pay.chmaba.com
