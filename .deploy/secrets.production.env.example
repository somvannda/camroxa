# Copy to secrets.production.env and fill in. NEVER commit secrets.production.env.
# Production-only credentials. Do not put sandbox hosts here.
# Only use this file when the user explicitly asks for a production deploy.
#
# Host: api / app / music / admin / camxora.com â†’ this VPS

VPS_HOST=82.197.71.248
VPS_USER=root
VPS_PASSWORD=

# Optional aliases (same host). Prefer VPS_* in this file.
# PRODUCTION_VPS_HOST=82.197.71.248
# PRODUCTION_VPS_USER=root
# PRODUCTION_VPS_PASSWORD=

VPS_SSH_KEY=

# uvicorn worker processes for platform_api. Defaults to 2 in
# camxora-production-remote.sh if unset here, but set it explicitly so a
# from-scratch redeploy never silently reverts to 1 (see
# docs/PRODUCTION_INFRASTRUCTURE_PLAN.md â€” target is 2 workers on the 6 vCPU
# production box; a single worker serializes all HTTP traffic behind every
# in-process background job â€” image generation, Suno streaming uploads,
# YouTube uploads â€” causing unrelated simple requests like /auth/refresh and
# /users/me to time out while a batch is running).
API_WORKERS=2

GIT_REPO=https://github.com/somvannda/camroxa.git
GIT_BRANCH=main
GITHUB_TOKEN=

ADMIN_EMAIL=you@example.com
CERTBOT_EMAIL=

DB_PASSWORD=
PLATFORM_JWT_SECRET=
PLATFORM_ENCRYPTION_MASTER_KEY=
PLATFORM_SUNO_CALLBACK_HMAC_SECRET=
# Suno callback egress IPs. Required: unsigned provider callbacks are accepted
# only from this allowlist.
PLATFORM_SUNO_CALLBACK_ALLOWED_IPS=47.89.217.55,47.77.231.163,47.251.163.235
# Music-web geo gate (X-Origin-Verify). Set the same value here and nginx sends
# it via apply_nginx.py; leave empty to keep the legacy (ungated) behavior.
EDGE_VERIFY_SECRET=

PLATFORM_CUTLUY_SECRET_KEY=
PLATFORM_CUTLUY_PAYMENT_LINK_ID=
PLATFORM_CUTLUY_WEBHOOK_SECRET=

PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_USE_TLS=true
PLATFORM_EMAIL_FROM_NAME=Camxora
PLATFORM_EMAIL_FROM_ADDRESS=noreply@camxora.com

# Production streaming B2 (private bucket)
PLATFORM_STREAMING_B2_KEY_ID=
PLATFORM_STREAMING_B2_APPLICATION_KEY=
PLATFORM_STREAMING_B2_BUCKET=productions-camxora-song
PLATFORM_STREAMING_B2_REGION=us-east-005
PLATFORM_STREAMING_B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com

# --- musicapi deploy (scripts/deploy/deploy_musicapi_production.py --yes) ------
# All optional: anything left blank is generated on the server on first deploy
# and persisted to /opt/camxora/.deploy-secrets, so redeploys keep JWT sessions
# and encrypted Suno cookies valid. Fill only what you already have.
# MUSICAPI_DB_PASSWORD=
# MUSICAPI_JWT_SECRET=
# MUSICAPI_COOKIE_ENCRYPTION_KEY=
# MUSICAPI_SUNO_CLIENT_COOKIE=
# MUSICAPI_SUNO_DEVICE_ID=
# MUSICAPI_SUNO_JWT=
# MUSICAPI_SUNO_CAPTCHA_TOKEN=
# MUSICAPI_TWOCAPTCHA_KEY=
# MUSICAPI_GOOGLE_CLIENT_ID=
# MUSICAPI_GOOGLE_CLIENT_SECRET=
# Google Search Console ownership token (the content value of the
# <meta name="google-site-verification"> tag). Required for Google OAuth brand
# verification; the deploy script bakes it into web-user's .env.production.
# MUSICAPI_GOOGLE_SITE_VERIFICATION=
# ChmabaPay hosted checkout (live gateway; there is no sandbox tier).
# MUSICAPI_CHMABA_API_KEY=
# MUSICAPI_CHMABA_STORE_ID=
# MUSICAPI_CHMABA_WEBHOOK_SECRET=
# MUSICAPI_FRONTEND_ORIGINS=https://musicapi.camxora.com,https://admin.musicapi.camxora.com
# MUSICAPI_LOG_LEVEL=info
# Job transport. Default is the in-memory driver. Set MUSICAPI_QUEUE_DRIVER=redis
# (with MUSICAPI_REDIS_URL) so descriptor-backed jobs re-queue across restarts
# instead of failing out as "Interrupted by server restart."
# MUSICAPI_QUEUE_DRIVER=memory
# MUSICAPI_REDIS_URL=redis://127.0.0.1:6379/2
# Suno-backed job concurrency. Unset -> built-in defaults (per-account 4, global
# pool.size × 4, per-user 2). Raise MUSICAPI_SUNO_MAX_CONCURRENT_PER_USER
# (e.g. 8) so one user can run more jobs in parallel across their API keys.
# MUSICAPI_SUNO_CONCURRENT_PER_ACCOUNT=4
# MUSICAPI_SUNO_MAX_CONCURRENT=
# MUSICAPI_SUNO_MAX_CONCURRENT_PER_USER=2
# MUSICAPI_SUNO_MAX_CONCURRENT_PER_ACCOUNT=4
# MUSICAPI_SUNO_MAX_QUEUE=1000
# Health-alert bot (task 4.6). Optional: when unset the platform's Telegram
# channel (PLATFORM_TELEGRAM_BOT_TOKEN + chat id, or platform_api/.env on the
# host) is reused for musicapi health alerts.
# MUSICAPI_ALERT_TELEGRAM_BOT_TOKEN=
# MUSICAPI_ALERT_TELEGRAM_CHAT_ID=
# Nightly backup retention (defaults shown).
# MUSICAPI_BACKUP_DIR=/opt/camxora/backups/musicapi
# MUSICAPI_BACKUP_RETENTION_DAYS=14
# Cross-product reporting: read-only DSN for the musicapi database, used by the
# ops daily Telegram digest for ChmabaPay / pack revenue. Unset = platform-only.
# PLATFORM_MUSICAPI_DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/sunoapi
