# Copy to secrets.env and fill in. NEVER commit secrets.env or paste it in chat.
# After filling, tell Cursor: "deploy secrets ready"

VPS_HOST=46.250.235.83
VPS_USER=root
VPS_PASSWORD=

# Optional: path to SSH private key (auto-generated at .deploy/camxora_deploy_ed25519 after bootstrap)
VPS_SSH_KEY=

GIT_REPO=https://github.com/somvannda/camroxa.git
GIT_BRANCH=cursor/channel-pricing-and-plan-tiers
# Required if repo is private:
GITHUB_TOKEN=

# Used for Let's Encrypt + first admin promotion after you register
ADMIN_EMAIL=you@example.com
CERTBOT_EMAIL=

# Leave blank to auto-generate on the server (saved to /opt/camxora/.deploy-secrets)
DB_PASSWORD=
PLATFORM_JWT_SECRET=
PLATFORM_ENCRYPTION_MASTER_KEY=
PLATFORM_SUNO_CALLBACK_HMAC_SECRET=

# CutLuy (live keys — add when ready; deploy works without them)
PLATFORM_CUTLUY_SECRET_KEY=
PLATFORM_CUTLUY_PAYMENT_LINK_ID=
PLATFORM_CUTLUY_WEBHOOK_SECRET=

# Outbound email — free/cheap SMTP relay (Resend / Brevo / Amazon SES)
# Do NOT use a paid private mailbox just for app mail. Do not self-host Postfix for outbound.
# Resend example: HOST=smtp.resend.com USER=resend PASS=<api_key>
# Brevo example:  HOST=smtp-relay.brevo.com USER=<login> PASS=<smtp_key>
PLATFORM_SMTP_HOST=
PLATFORM_SMTP_PORT=587
PLATFORM_SMTP_USER=
PLATFORM_SMTP_PASSWORD=
PLATFORM_SMTP_USE_TLS=true
PLATFORM_EMAIL_FROM_NAME=Camxora

# Ops Telegram activity feed. Create bot via @BotFather.
# Maps to Settings.telegram_bot_token / telegram_chat_id (PLATFORM_ prefix).
PLATFORM_TELEGRAM_BOT_TOKEN=
PLATFORM_TELEGRAM_CHAT_ID=
PLATFORM_TELEGRAM_OPS_ENABLED=true
PLATFORM_EMAIL_FROM_ADDRESS=noreply@camxora.com

# Optional: separate production VPS (defaults to VPS_HOST / VPS_USER when unset)
# See docs/PRODUCTION_CUTOVER.md before first production deploy.
PRODUCTION_VPS_HOST=
PRODUCTION_VPS_USER=
PRODUCTION_VPS_PASSWORD=
# PRODUCTION_VPS_SSH_KEY=

# --- musicapi deploy (scripts/deploy/sync_musicapi_sandbox.py) -----------------
# All optional: anything left blank is generated on the server on first deploy
# and persisted to /opt/camxora/.deploy-secrets, so redeploys keep JWT sessions
# and encrypted Suno cookies valid. Fill only what you already have.
# MUSICAPI_DB_PASSWORD=
# MUSICAPI_JWT_SECRET=
# MUSICAPI_COOKIE_ENCRYPTION_KEY=
# MUSICAPI_SUNO_CLIENT_COOKIE=
# MUSICAPI_SUNO_DEVICE_ID=
# MUSICAPI_SUNO_JWT=
# MUSICAPI_SUNO_CAPTCHA_TOKEN=
# MUSICAPI_TWOCAPTCHA_KEY=
# MUSICAPI_GOOGLE_CLIENT_ID=
# MUSICAPI_GOOGLE_CLIENT_SECRET=
# MUSICAPI_BAKONG_API_TOKEN=
# MUSICAPI_BAKONG_ACCOUNT_ID=
# MUSICAPI_FRONTEND_ORIGINS=https://app.musicapi.sandbox.camxora.com,https://admin.musicapi.sandbox.camxora.com
# MUSICAPI_LOG_LEVEL=info
