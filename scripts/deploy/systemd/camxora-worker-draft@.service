# Stage-sharded CamXora job workers (template instances).
# Enable examples:
#   systemctl enable --now camxora-worker-draft@{1,2}.service
#   systemctl enable --now camxora-worker-suno@{1,2}.service
#   systemctl enable --now camxora-worker-images@{1,2}.service

[Unit]
Description=CamXora Job Worker (%i / draft stage)
After=network.target postgresql.service redis-server.service camxora-api.service
Wants=postgresql.service redis-server.service

[Service]
User=camxora
Group=camxora
WorkingDirectory=/opt/camxora/repo
Environment=PYTHONPATH=/opt/camxora/repo
Environment=PYTHONUNBUFFERED=1
Environment=CAMXORA_WORKER_JOB_TYPES=draft
Environment=CAMXORA_WORKER_NAME=draft@%i
EnvironmentFile=/opt/camxora/repo/platform_api/.env
ExecStart=/opt/camxora/repo/platform_api/.venv/bin/python -m platform_api.worker
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
