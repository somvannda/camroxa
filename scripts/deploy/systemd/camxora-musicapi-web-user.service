[Unit]
Description=CamXora Music API — user web (Next.js)
After=network.target

[Service]
User=camxora
Group=camxora
WorkingDirectory=/opt/camxora/repo/musicapi/web-user
Environment=NODE_ENV=production
Environment=PORT=4001
Environment=TZ=Asia/Phnom_Penh
ExecStart=/usr/bin/npm run start -- -p ${PORT} -H 127.0.0.1
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
