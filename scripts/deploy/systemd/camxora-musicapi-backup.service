[Unit]
Description=CamXora Music API database backup (pg_dump)
After=postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=camxora
Group=camxora
WorkingDirectory=/opt/camxora/repo/musicapi
EnvironmentFile=/opt/camxora/repo/musicapi/.env
ExecStart=/usr/bin/env bash /opt/camxora/repo/scripts/deploy/musicapi-backup.sh
Nice=10
