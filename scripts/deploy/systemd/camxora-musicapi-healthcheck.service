[Unit]
Description=CamXora Music API health probe + alert
After=network.target

[Service]
Type=oneshot
User=camxora
Group=camxora
WorkingDirectory=/opt/camxora/repo/musicapi
EnvironmentFile=-/opt/camxora/repo/musicapi/.env
ExecStart=/usr/bin/env bash /opt/camxora/repo/scripts/deploy/musicapi-healthcheck.sh
