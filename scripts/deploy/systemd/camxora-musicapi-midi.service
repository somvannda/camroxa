[Unit]
Description=CamXora Music API — MIDI (Basic Pitch) microservice
After=network.target

[Service]
User=camxora
Group=camxora
WorkingDirectory=/opt/camxora/midi-service
Environment=TZ=Asia/Phnom_Penh
Environment=MIDI_PORT=4010
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/camxora/midi-service/.venv/bin/python /opt/camxora/midi-service/server.py
Restart=always
RestartSec=5
# Basic Pitch model load takes a few seconds on first boot.
TimeoutStartSec=120
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
