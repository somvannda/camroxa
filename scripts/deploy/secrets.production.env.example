
# --- Mail (Resend) ---------------------------------------------------------
# The management surfaces (API key, webhook secret, From identities) live in
# app_settings, encrypted, editable at /admin/settings > Mail (Resend).
# These two are deployment-level because they decide which hostname is printed
# inside every email, and a wrong value breaks links on mail already delivered.
#
# mail.camxora.com is its own nginx vhost (see nginx-musicapi-production.conf):
# open pixel, click redirect, unsubscribe page and the Resend webhook.
MUSICAPI_MAIL_PUBLIC_BASE_URL=https://mail.camxora.com
# CTA target in templates — the product site users buy on.
MUSICAPI_MAIL_APP_URL=https://music.camxora.com
