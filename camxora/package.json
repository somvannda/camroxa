{
  "name": "camxora",
  "private": true,
  "version": "0.1.0",
  "description": "CAMXORA Electron desktop app foundation",
  "author": "CAMXORA",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev:clean": "node -e \"const fs=require('fs');const rm=(p)=>fs.rmSync(p,{force:true,recursive:false});rm('dist/main/index.cjs');rm('dist/preload/index.cjs');\"",
    "dev": "npm run dev:clean && concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:preload\" \"npm:dev:electron\"",
    "dev:renderer": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "dev:main": "tsup src/main/index.ts --format cjs --out-dir dist/main --external electron --watch",
    "dev:preload": "tsup src/preload/index.ts --format cjs --out-dir dist/preload --external electron --watch",
    "dev:electron": "wait-on tcp:5174 dist/main/index.cjs dist/preload/index.cjs && electronmon .",
    "build": "npm run build:renderer && npm run build:main && npm run build:preload",
    "build:renderer": "vite build",
    "build:main": "tsup src/main/index.ts --format cjs --out-dir dist/main --external electron --minify",
    "build:preload": "tsup src/preload/index.ts --format cjs --out-dir dist/preload --external electron --minify",
    "dist:win": "npm run build && electron-builder --win nsis",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.1.0",
    "@tanstack/react-query": "^5.59.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^7.3.0",
    "tailwind-merge": "^3.0.2",
    "zod": "^3.23.8",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.0.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "electronmon": "^2.0.2",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsup": "^8.3.0",
    "tsx": "^4.19.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-plugin-trae-solo-badge": "^1.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.1",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.camxora.desktop",
    "productName": "CAMXORA",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public/app.ico",
        "to": "app.ico"
      }
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "icon": "public/app.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis"
      ]
    }
  }
}
